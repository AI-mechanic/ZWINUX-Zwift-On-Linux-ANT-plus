diff --git a/src/descriptors.c b/src/descriptors.c
index f24bbfa..2c67fc9 100644
--- a/src/descriptors.c
+++ b/src/descriptors.c
@@ -9,20 +9,27 @@
 #include <stdio.h>
 #include <string.h>
 #include <stdint.h>
+#include <errno.h>
 #include "usbi.h"
 
-int usb_get_descriptor_by_endpoint(usb_dev_handle *udev, int ep,
+LIBUSB_API int usb_get_descriptor_by_endpoint(usb_dev_handle *udev, int ep,
 	unsigned char type, unsigned char index, void *buf, int size)
 {
+  if (!buf || size < 0)
+    USB_ERROR_STR(-EINVAL, "usb_get_descriptor_by_endpoint: invalid buffer");
+
